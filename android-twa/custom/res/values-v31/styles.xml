<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ always draws a system-owned first frame. Keep it black
         with no visible icon, then let Browser Helper animate and hand off
         the one complete DALMUTI splash. -->
    <style name="DalmutiLaunchTheme" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/backgroundColor</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/dalmuti_splash_transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
