<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ always draws a system-owned starting window. Keep that
         mandatory frame black-on-black and animation-free, then let Browser
         Helper launch the TWA immediately. -->
    <style name="DalmutiLaunchTheme" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/backgroundColor</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/dalmuti_splash_os_black_v4</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/black</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
