{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dclab.local/schemas/dalmuti-v3-distillation-v1.json",
  "title": "DALMUTI V3 distillation NDJSON records",
  "oneOf": [
    { "$ref": "#/$defs/manifest" },
    { "$ref": "#/$defs/sample" },
    { "$ref": "#/$defs/summary" }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "finiteNumber": {
      "type": "number"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "format",
        "formatVersion",
        "createdAt",
        "teacher",
        "observation",
        "actionSpace",
        "grouping",
        "selection",
        "sources"
      ],
      "properties": {
        "type": { "const": "manifest" },
        "format": { "const": "dalmuti-v3-distillation-ndjson" },
        "formatVersion": { "const": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "teacher": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "filename",
            "sha256",
            "format",
            "version",
            "observationFeatures",
            "actionCount",
            "temperature",
            "targets"
          ],
          "properties": {
            "filename": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "format": { "const": "dalmuti-actor-critic" },
            "version": { "const": 1 },
            "observationFeatures": { "const": 172 },
            "actionCount": { "const": 506 },
            "temperature": { "type": "number", "exclusiveMinimum": 0 },
            "targets": { "type": "string", "minLength": 1 }
          }
        },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "featureCount", "privacy"],
          "properties": {
            "schemaVersion": { "const": 2 },
            "featureCount": { "const": 172 },
            "privacy": { "type": "string", "minLength": 1 }
          }
        },
        "actionSpace": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "legacySize",
            "catalogueVersion",
            "size",
            "catalogue",
            "actionFeatures",
            "actionFeatureLayout",
            "encodedActionFeatures",
            "mapping"
          ],
          "properties": {
            "legacySize": { "const": 506 },
            "catalogueVersion": { "const": 1 },
            "size": { "const": 236 },
            "catalogue": {
              "type": "array",
              "minItems": 236,
              "maxItems": 236,
              "items": { "type": "object" }
            },
            "actionFeatures": { "const": 22 },
            "actionFeatureLayout": {
              "type": "array",
              "minItems": 22,
              "maxItems": 22,
              "items": { "type": "string" }
            },
            "encodedActionFeatures": {
              "type": "array",
              "minItems": 236,
              "maxItems": 236,
              "items": {
                "type": "array",
                "minItems": 22,
                "maxItems": 22,
                "items": { "$ref": "#/$defs/finiteNumber" }
              }
            },
            "mapping": { "type": "string", "minLength": 1 }
          }
        },
        "grouping": {
          "type": "object",
          "additionalProperties": false,
          "required": ["splitUnit", "rule"],
          "properties": {
            "splitUnit": { "const": "sourceSha256:episodeId" },
            "rule": { "type": "string", "minLength": 1 }
          }
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["order", "maxSamplesPerSource", "includeForced"],
          "properties": {
            "order": { "type": "string", "minLength": 1 },
            "maxSamplesPerSource": { "type": "integer", "minimum": 1 },
            "includeForced": { "type": "boolean" }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "filename",
              "sha256",
              "bytes",
              "manifestSha256",
              "playerCount",
              "behaviorModelSha256",
              "behaviorModelFormat"
            ],
            "properties": {
              "filename": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256" },
              "bytes": { "type": "integer", "minimum": 1 },
              "manifestSha256": { "$ref": "#/$defs/sha256" },
              "playerCount": { "type": "integer", "minimum": 4, "maximum": 10 },
              "behaviorModelSha256": { "$ref": "#/$defs/sha256" },
              "behaviorModelFormat": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sampleId",
        "sourceSha256",
        "episodeId",
        "trajectoryId",
        "groupKey",
        "observation",
        "legacyLegalActionIndices",
        "legalActionIndices",
        "teacherLogits",
        "teacherLogProbabilities",
        "teacherArgmaxActionIndex",
        "teacherValue"
      ],
      "properties": {
        "type": { "const": "sample" },
        "sampleId": { "type": "string", "minLength": 1 },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "episodeId": { "type": "string", "minLength": 1 },
        "trajectoryId": { "type": "string", "minLength": 1 },
        "groupKey": { "type": "string", "minLength": 66 },
        "observation": {
          "type": "array",
          "minItems": 172,
          "maxItems": 172,
          "items": { "$ref": "#/$defs/finiteNumber" }
        },
        "legacyLegalActionIndices": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0, "maximum": 505 }
        },
        "legalActionIndices": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0, "maximum": 235 }
        },
        "teacherLogits": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/finiteNumber" }
        },
        "teacherLogProbabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/finiteNumber" }
        },
        "teacherArgmaxActionIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 235
        },
        "teacherValue": { "$ref": "#/$defs/finiteNumber" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "samples",
        "uniqueGroups",
        "teacherSha256",
        "temperature",
        "sourceSampleCounts"
      ],
      "properties": {
        "type": { "const": "summary" },
        "samples": { "type": "integer", "minimum": 1 },
        "uniqueGroups": { "type": "integer", "minimum": 1 },
        "teacherSha256": { "$ref": "#/$defs/sha256" },
        "temperature": { "type": "number", "exclusiveMinimum": 0 },
        "sourceSampleCounts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
