{
  "name": "dalmuti-web-game",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:lan": "vinext dev --hostname 0.0.0.0",
    "build": "vinext build",
    "start": "vinext start",
    "test": "pnpm run build && node --test tests/rendered-html.test.mjs tests/online-engine.test.mjs tests/quick-dalmuti.test.mjs tests/online-chat-and-score.test.mjs tests/bot-strategy.test.mjs tests/temporary-test-mode.test.mjs tests/online-action-presentation.test.mjs tests/mobile-installed-parity.test.mjs tests/desktop-quick-online-parity.test.mjs tests/rulebook.test.mjs tests/pwa.test.mjs tests/reinforcement-learning.test.mjs",
    "test:rl": "node --test tests/reinforcement-learning.test.mjs",
    "rl:evaluate": "node scripts/rl-evaluate.mjs",
    "rl:evaluate-model": "node scripts/rl-evaluate-model.mjs",
    "rl:benchmark-model": "node scripts/rl-benchmark-model.mjs",
    "rl:verify-result": "node scripts/rl-verify-training-result.mjs",
    "rl:rollouts": "node scripts/rl-generate-rollouts.mjs",
    "rl:dagger": "node scripts/rl-generate-dagger.mjs",
    "rl:ppo-rollouts": "node scripts/rl-generate-ppo-rollouts.mjs",
    "rl:ppo-league-rollouts": "node scripts/rl-generate-league-rollouts.mjs",
    "rl:ppo-bundle": "node scripts/rl-prepare-ppo-bundle.mjs",
    "rl:ppo-prepare": "node scripts/rl-prepare-next-ppo.mjs",
    "rl:gpu-bundle": "node scripts/rl-prepare-gpu-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern artifacts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
